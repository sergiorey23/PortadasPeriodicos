<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up only what a user would want on a new phone (favorites, settings, theme).
     Everything else (image cache, counters, billing flag) is rebuilt or restored through Google Play. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/favorites.preferences_pb" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/theme_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/favorites.preferences_pb" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/theme_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
