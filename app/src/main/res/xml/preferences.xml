<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/tema"
        app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="switch_preference"
            android:title="@string/mode"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>
    <ListPreference
        android:defaultValue="@string/first_tab"
        android:summary="@string/first_tab"
        app:iconSpaceReserved="false"
        android:entries="@array/portadas_categories"
        android:entryValues="@array/portadas_categories"
        android:key="init_category"
        android:title="Categoría incial" />
</androidx.preference.PreferenceScreen>