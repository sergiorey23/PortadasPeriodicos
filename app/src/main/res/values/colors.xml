<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 color roles for the light scheme (seed: the app-bar cyan). The dark scheme is in values-night/colors.xml
     with the same names, so the theme refers to each role once. -->
<resources>
    <color name="primary">#006A7A</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#B8EFFF</color>
    <color name="on_primary_container">#001F26</color>
    <color name="secondary">#4A6168</color>
    <color name="on_secondary">#FFFFFF</color>
    <color name="secondary_container">#CDE7EE</color>
    <color name="on_secondary_container">#051F26</color>
    <color name="tertiary">#456179</color>
    <color name="on_tertiary">#FFFFFF</color>
    <color name="tertiary_container">#CCE5FF</color>
    <color name="on_tertiary_container">#001E31</color>
    <color name="error">#BA1A1A</color>
    <color name="on_error">#FFFFFF</color>
    <color name="error_container">#FFDAD6</color>
    <color name="on_error_container">#410002</color>

    <color name="background">#F5FAFB</color>
    <color name="on_background">#171C1E</color>
    <color name="surface">#F5FAFB</color>
    <color name="on_surface">#171C1E</color>
    <color name="surface_variant">#DBE4E8</color>
    <color name="on_surface_variant">#3F484B</color>
    <color name="outline">#70797C</color>
    <color name="outline_variant">#BFC8CC</color>
    <color name="inverse_surface">#2C3133</color>
    <color name="inverse_on_surface">#ECF1F3</color>
    <color name="inverse_primary">#60D5E9</color>
    <color name="surface_dim">#D6DBDD</color>
    <color name="surface_bright">#F5FAFB</color>
    <color name="surface_container_lowest">#FFFFFF</color>
    <color name="surface_container_low">#EFF4F6</color>
    <color name="surface_container">#EAEFF1</color>
    <color name="surface_container_high">#E4E9EB</color>
    <color name="surface_container_highest">#DEE3E5</color>

    <!-- App-specific: a light cyan app bar in light mode. -->
    <color name="app_bar">#60D5E9</color>
    <color name="on_app_bar">#000000</color>
    <color name="app_bar_gradient_end">#4DC3DC</color>
    <!-- Heart of a favorite newspaper: the state is shown by color, not by fill. -->
    <color name="favorite_active">#E53935</color>
    <!-- Globe of the "website" button: the usual link blue. -->
    <color name="web_link">#1A73E8</color>
    <!-- Ribbon on covers that are not today's edition; drawn over the image, so identical in both modes. -->
    <color name="date_ribbon">#D32F2F</color>
    <color name="on_date_ribbon">#FFFFFF</color>
    <!-- Picked date under the app title: a dark red that stands out on the light app bar. -->
    <color name="app_bar_date">#8E1111</color>
</resources>
