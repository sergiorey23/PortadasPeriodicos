<resources>

    <!--
    AppTheme is now DayNight-aware: this file holds the light-mode attribute
    values, and values-night/styles.xml redefines the SAME style name with
    dark-mode values. AppCompatDelegate.setDefaultNightMode() (set from
    ThemeRepositoryImpl's persisted ThemeMode) decides which of the two gets
    resolved, for every Activity, automatically.

    This replaces the old setup where AppTheme and AppThemeDark were two
    unrelated styles (different parents, divergent attribute sets) and every
    Activity had to manually call setTheme(R.style.AppThemeDark) after
    checking Configuration.UI_MODE_NIGHT_MASK by hand — a second, independent
    light/dark switch that could (and did) fall out of sync with
    AppCompatDelegate's own night mode.
    -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@android:color/holo_green_dark</item>
        <item name="android:navigationBarColor">@android:color/background_light</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:windowContentTransitions">true</item>

        <item name="buttonBarNegativeButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.MaterialComponents.Button</item>

        <item name="materialAlertDialogTheme">@style/MaterialAlertDialog</item>
        <item name="materialCalendarStyle">@style/Widget.MaterialComponents.MaterialCalendar</item>
        <item name="materialCalendarFullscreenTheme">@style/ThemeOverlay.MaterialComponents.MaterialCalendar.Fullscreen</item>
        <item name="materialCalendarTheme">@style/MaterialCalendarThemeLight</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
    </style>

    <style name="MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MaterialComponents.Button</item>
    </style>
    <style name="MaterialAlertDialogDark" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/MaterialAlertDialogButtonText</item>
        <item name="buttonBarNeutralButtonStyle">@style/MaterialAlertDialogButtonText</item>
    </style>
    <style name="MaterialAlertDialogButtonText" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/whiteAlpha</item>
    </style>
    <style name="MaterialCalendarTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <!-- Buttons -->
        <item name="buttonBarPositiveButtonStyle">@style/TextButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/TextButton</item>

    </style>
    <style name="MaterialCalendarThemeLight" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <!-- Buttons -->
        <item name="buttonBarPositiveButtonStyle">@style/TextButtonLight</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.MaterialComponents.Button</item>

    </style>
    <style name="TextButtonLight" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_marginLeft">20dp</item>
    </style>
    <style name="TextButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/background_material_dark</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="colorPrimary">@color/colorPrimary</item>
    </style>

    <style name="TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">@android:color/white</item>
        <item name="tabSelectedTextColor">@android:color/white</item>
    </style>
    <style name="ActionBar.nameText" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">cursive</item>
    </style>

    <style name="ActionBar.detalle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WindowAnimationTransition">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
</resources>
