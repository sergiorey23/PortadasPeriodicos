<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Portadas.AppBarLayout" parent="Widget.Material3.AppBarLayout">
        <item name="android:background">?attr/colorAppBar</item>
        <item name="liftOnScroll">false</item>
    </style>

    <style name="Widget.Portadas.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorAppBar</item>
        <item name="titleTextColor">?attr/colorOnAppBar</item>
        <item name="subtitleTextColor">?attr/colorOnAppBar</item>
        <item name="navigationIconTint">?attr/colorOnAppBar</item>
        <item name="titleTextAppearance">@style/TextAppearance.Portadas.AppTitle</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Material3.BodyMedium</item>
        <item name="android:theme">@style/ThemeOverlay.Portadas.AppBar</item>
    </style>

    <style name="Widget.Portadas.Toolbar.Detail">
        <item name="titleTextAppearance">@style/TextAppearance.Portadas.DetailTitle</item>
    </style>

    <style name="Widget.Portadas.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="android:background">?attr/colorAppBar</item>
        <item name="tabIndicatorColor">?attr/colorOnAppBar</item>
        <item name="tabTextColor">@color/tab_text</item>
        <item name="tabRippleColor">@android:color/transparent</item>
    </style>

    <!-- The app name in the toolbar and in the About dialog. -->
    <style name="TextAppearance.Portadas.AppTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">cursive</item>
        <item name="fontFamily">cursive</item>
    </style>

    <style name="TextAppearance.Portadas.DetailTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <!-- "This cover is from an earlier day": a red tag with the edition date, top-right of a cover. -->
    <style name="Widget.Portadas.DateRibbon" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:background">@drawable/bg_date_ribbon</item>
        <item name="android:textColor">@color/on_date_ribbon</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">5dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="Animation.Portadas.Window" parent="">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>


    <!-- Square corners (the Material 3 drawer rounds its trailing edge by default). -->
    <style name="ShapeAppearanceOverlay.Portadas.Square" parent="">
        <item name="cornerSize">0dp</item>
    </style>


    <!-- Pure-black dark theme for AMOLED screens, applied on top of Theme.Portadas in dark mode (see PureBlackTheme). -->
    <style name="ThemeOverlay.Portadas.PureBlack" parent="">
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceDim">#000000</item>
        <item name="colorSurfaceBright">#2A2A2A</item>
        <item name="colorSurfaceVariant">#1C1C1C</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#0A0A0A</item>
        <item name="colorSurfaceContainer">#101010</item>
        <item name="colorSurfaceContainerHigh">#171717</item>
        <item name="colorSurfaceContainerHighest">#1F1F1F</item>
        <item name="colorAppBar">#000000</item>
        <item name="colorAppBarEnd">#000000</item>
    </style>

</resources>
